# Optimistic w/Bucketed GVT, the delay-quantile rule fed by the GVT's count
# waves (--ctl-reduction=1): a decision every wave, the full histogram on
# every 8th
sync=3
gvt=4
buffer-size=655360
optimism-window=2000
ctl=1
ctl-reduction=1
ctl-interval=1
ctl-hist-waves=8
# The counters on every wave (the path before --ctl-sparse-waves)
ctl-sparse-waves=0
