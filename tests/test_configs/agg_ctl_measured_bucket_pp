# Optimistic w/Bucketed GVT, htram (PP), deadline flush policy, the window
# set by measured cost (--ctl=3): the delay histogram gives the scale, and W
# moves toward lower PE time per committed event
sync=3
gvt=4
buffer-size=655360
optimism-window=2000
aggregation=1
agg-mode=2
agg-buffer=16
agg-policy=1
ctl=3
