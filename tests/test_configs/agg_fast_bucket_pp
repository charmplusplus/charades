# Optimistic w/Bucketed GVT and a window, htram (PP), deadline flush policy,
# with the per-event fast paths: input-buffer delivery, the hash index and the
# message pool
sync=3
gvt=4
buffer-size=655360
optimism-window=2000
aggregation=1
agg-mode=2
agg-buffer=16
agg-policy=1
agg-input-buffer=1
event-index=1
msg-pool=1
