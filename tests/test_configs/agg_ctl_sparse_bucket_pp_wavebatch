# agg_ctl_sparse_bucket_pp with --wave-batch=4: passes of 4 events while a count wave is in flight
# set by the delay-quantile rule with the aggregation bound (kappa) and sparse
# controller waves (counters only on the wave that ends a round)
sync=3
gvt=4
buffer-size=655360
optimism-window=2000
aggregation=1
agg-mode=2
agg-buffer=16
agg-policy=1
ctl=1
ctl-agg-kappa=0.2
ctl-sparse-waves=1
ctl-hist-waves=32
wave-batch=4
