From 2c90067bbdfd189e491bb1495b86d33f8c6a2324 Mon Sep 17 00:00:00 2001
From: Ritvik Rao <rsrao2@illinois.edu>
Date: Mon, 26 Oct 2026 12:19:46 -0500
Subject: [PATCH] +lci_dest_device: send PE-directed messages on the
 destination PE's device

LCI pairs device i of one process only with device i of another, so a
message lands on the receiver's device with the sender's index and is
drained by whichever PEs poll that device, not by its destination PE. In
Charades at Gaussian sigma 100, the process-edge ranks 0 and 22 drained
each other's messages: each allocated the receive buffers from its own
pool, the destination freed them into it, and the two contended on each
other's pool locks (charades RESULTS.md section 99).

With +lci_dest_device, CmiSyncSendAndFree names the destination rank for
the next issueAm (setSendRankHint), and the LCI2 backend sends on the
device that rank polls, with that device's memory registration; a sender
waiting to retry also polls that device. Node-level messages and other
backends are unchanged. Assumes every process has the same number of PE
threads. Off by default.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/comm_backend/comm_backend.h             |  8 ++++
 src/comm_backend/comm_backend_internal.cpp  | 10 +++++
 src/comm_backend/lci2/comm_backend_lci2.cpp | 44 +++++++++++++++++++--
 src/comm_backend/lci2/comm_backend_lci2.h   |  8 ++++
 src/convcore.cpp                            |  1 +
 5 files changed, 68 insertions(+), 3 deletions(-)

diff --git a/src/comm_backend/comm_backend.h b/src/comm_backend/comm_backend.h
index d75e28f..8c86463 100644
--- a/src/comm_backend/comm_backend.h
+++ b/src/comm_backend/comm_backend.h
@@ -62,6 +62,14 @@ AmHandler registerAmHandler(CompHandler handler);
  */
 void issueAm(int rank, const void *local_buf, size_t size, mr_t mr,
              CompHandler localComp, AmHandler remoteComp, void *user_context);
+/**
+ * @brief Name the destination PE's rank (within its process) for the next
+ * issueAm from this thread. With +lci_dest_device the LCI2 backend sends on
+ * the device that rank polls, so the message is drained by its destination
+ * PE. Other backends ignore it. Thread-safe (per-thread state).
+ */
+void setSendRankHint(int destRank);
+int takeSendRankHint();
 /**
  * @brief Issue a remote get operation. Thread-safe.
  */
diff --git a/src/comm_backend/comm_backend_internal.cpp b/src/comm_backend/comm_backend_internal.cpp
index f6c78e5..ff0272a 100644
--- a/src/comm_backend/comm_backend_internal.cpp
+++ b/src/comm_backend/comm_backend_internal.cpp
@@ -96,6 +96,16 @@ AmHandler registerAmHandler(CompHandler handler) {
   return gCommBackend->registerAmHandler(handler);
 }
 
+static thread_local int t_send_rank_hint = -1;
+
+void setSendRankHint(int destRank) { t_send_rank_hint = destRank; }
+
+int takeSendRankHint() {
+  int r = t_send_rank_hint;
+  t_send_rank_hint = -1;
+  return r;
+}
+
 void issueAm(int rank, const void *msg, size_t size, mr_t mr, CompHandler localComp,
              AmHandler remoteComp, void *user_context) {
   if (gCommBackend == nullptr) {
diff --git a/src/comm_backend/lci2/comm_backend_lci2.cpp b/src/comm_backend/lci2/comm_backend_lci2.cpp
index 63780e3..a80854a 100644
--- a/src/comm_backend/lci2/comm_backend_lci2.cpp
+++ b/src/comm_backend/lci2/comm_backend_lci2.cpp
@@ -190,6 +190,8 @@ void CommBackendLCI2::init(char **argv) {
   int num_devices = 1;
   CmiGetArgInt(argv, "+lci_ndevices", (int *)&num_devices);
   CmiAssert(num_devices >= 1);
+  m_dest_device = CmiGetArgFlagDesc(argv, "+lci_dest_device",
+      "send each PE-directed message on the device its destination PE polls");
 
   lci::global_initialize();
   auto g_attr = lci::get_g_default_attr();
@@ -261,6 +263,7 @@ void CommBackendLCI2::initThread(int thread_id, int num_threads) {
   detail::g_thread_context.thread_id = thread_id;
   int nthreads_per_device =
       (num_threads + m_devices.size() - 1) / m_devices.size();
+  m_nthreads_per_device = nthreads_per_device;
   int device_id = thread_id / nthreads_per_device;
   CmiAssert(device_id < m_devices.size());
   detail::g_thread_context.device_idx = device_id;
@@ -298,16 +301,34 @@ void CommBackendLCI2::issueAm(int rank, const void *local_buf, size_t size, mr_t
   // queue. Use allow_retry=false so LCI pushes to its backlog queue and returns
   // immediately; the backlog is drained in the next progress() call.
   bool allow_retry = !detail::g_in_progress_callback;
+  // +lci_dest_device: the message lands on the receiver's device with the
+  // index it was sent on, so send it on the device its destination PE polls.
+  // The send then completes on that device here, polled by its own threads.
+  int hint = takeSendRankHint();
+  int dest_dev = -1;
+  if (m_dest_device && hint >= 0 && detail::g_thread_context.device_idx >= 0) {
+    dest_dev = hint / m_nthreads_per_device;
+    if (dest_dev >= (int)m_devices.size()) dest_dev = (int)m_devices.size() - 1;
+    if (dest_dev == detail::g_thread_context.device_idx) dest_dev = -1;
+  }
+  lci::device_t device =
+      dest_dev >= 0 ? m_devices[dest_dev] : getThreadLocalDevice();
+  lci::mr_t lmr = getThreadLocalMR(mr);
+  if (dest_dev >= 0 && mr != MR_NULL)
+    lmr = lci::mr_t(static_cast<lci::mr_impl_t **>(mr)[dest_dev]);
   do {
     // we use LCI tag to pass the remoteComp
     status = lci::post_am_x(rank, const_cast<void *>(local_buf), size,
                             m_local_comp, m_rcomp)
-                 .mr(getThreadLocalMR(mr))
-                 .device(getThreadLocalDevice())
+                 .mr(lmr)
+                 .device(device)
                  .tag(remoteComp)
                  .user_context(args)
                  .allow_retry(allow_retry)();
-    if (allow_retry) progress();
+    if (allow_retry) {
+      progress();
+      if (dest_dev >= 0) progressDevice(dest_dev);
+    }
   } while (status.is_retry());
   if (status.is_done()) {
     localComp({local_buf, size, user_context});
@@ -368,6 +389,23 @@ bool CommBackendLCI2::threadMustPoll() {
   return detail::g_thread_context.device_poller;
 }
 
+// Poll one device under its trylock; used by a sender waiting on another
+// thread's device (+lci_dest_device).
+bool CommBackendLCI2::progressDevice(int dev_idx) {
+  bool expected = false;
+  if (!m_progress_locks[dev_idx].v.compare_exchange_strong(
+          expected, true, std::memory_order_acquire,
+          std::memory_order_relaxed)) {
+    return false;
+  }
+  bool prev_in_cb = detail::g_in_progress_callback;
+  detail::g_in_progress_callback = true;
+  auto ret = lci::progress_x().device(m_devices[dev_idx])();
+  detail::g_in_progress_callback = prev_in_cb;
+  m_progress_locks[dev_idx].v.store(false, std::memory_order_release);
+  return ret.is_done();
+}
+
 bool CommBackendLCI2::progress(void) {
   // OFI fi_cq_read is not thread-safe. Use a per-device trylock so at most
   // one thread polls each device CQ at a time. Callers that lose the race
diff --git a/src/comm_backend/lci2/comm_backend_lci2.h b/src/comm_backend/lci2/comm_backend_lci2.h
index c525d0a..799e92d 100644
--- a/src/comm_backend/lci2/comm_backend_lci2.h
+++ b/src/comm_backend/lci2/comm_backend_lci2.h
@@ -90,6 +90,14 @@ private:
   std::unordered_set<void *> m_liveMrs;
   void deregisterAllMemory();
 
+  // +lci_dest_device: send a PE-directed message on the device its
+  // destination rank polls (device i of one process talks only to device i of
+  // another), instead of on the sending thread's device. Assumes every process
+  // has the same number of PE threads.
+  bool m_dest_device = false;
+  int m_nthreads_per_device = 1;
+  bool progressDevice(int dev_idx);
+
   lci::device_t getThreadLocalDevice();
   lci::mr_t getThreadLocalMR(mr_t mr);
   lci::rmr_t getThreadLocalRMR(void *rmr);
diff --git a/src/convcore.cpp b/src/convcore.cpp
index 1be5571..5f5c4a8 100644
--- a/src/convcore.cpp
+++ b/src/convcore.cpp
@@ -936,6 +936,7 @@ void CmiSyncSendAndFreeNoPersistent(int destPE, int messageSize, void *msg) {
                                    msg)) {
     // Not a peer process on this host, or too big for the pool: over the
     // network it goes.
+    comm_backend::setSendRankHint(CmiRankOf(destPE));
     comm_backend::issueAm(CmiNodeToGlobal(destNode), msg, messageSize,
                           MRFIELD(msg), CommLocalHandler, g_amHandler,
                           nullptr); // Commlocalhandler will free msg
