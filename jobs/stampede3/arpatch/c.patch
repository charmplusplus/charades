From 8a8abfa2839de57689f84f827ccaa33488c5b630 Mon Sep 17 00:00:00 2001
From: Ritvik Rao <rsrao2@illinois.edu>
Date: Sat, 24 Oct 2026 13:52:31 -0500
Subject: [PATCH] --pe-stats=1: PE 0 writes each PE's events, rollbacks and
 batch outcomes to pe_stats.csv

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/globals.C              |  2 ++
 src/globals.h              |  1 +
 src/scheduler/scheduler.C  | 38 +++++++++++++++++++++++++++++++++++++-
 src/scheduler/scheduler.ci |  1 +
 src/scheduler/scheduler.h  |  4 ++++
 src/util/command_line.C    |  1 +
 6 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/src/globals.C b/src/globals.C
index 720433f..4a86d35 100644
--- a/src/globals.C
+++ b/src/globals.C
@@ -42,6 +42,7 @@ unsigned g_tw_gvt_phases;
 unsigned g_tw_gvt_bucket_size;
 unsigned g_tw_gvt_min_buckets;
 unsigned g_tw_gvt_trace;
+unsigned g_tw_pe_stats;
 unsigned g_tw_gvt_wave_events;
 unsigned g_tw_gvt_node_waves;
 unsigned g_tw_gvt_wave_allreduce;
@@ -122,6 +123,7 @@ void clear_globals() {
   g_tw_gvt_bucket_size    = 8;
   g_tw_gvt_min_buckets    = 1;
   g_tw_gvt_trace          = 0;
+  g_tw_pe_stats           = 0;
   // Paced count waves are 1.0-1.38x faster on 4 nodes and remove the
   // run-to-run flip between two GVT paces (RESULTS.md, "Two speeds")
   g_tw_gvt_wave_events    = 128;
diff --git a/src/globals.h b/src/globals.h
index 4d14047..1b742a0 100644
--- a/src/globals.h
+++ b/src/globals.h
@@ -45,6 +45,7 @@ extern unsigned g_tw_gvt_trigger;     ///< unit of the GVT interval (time or eve
 extern unsigned g_tw_gvt_phases;      ///< number of phases in a phased gvt
 extern unsigned g_tw_gvt_bucket_size; ///< size of each bucket in a bucketed gvt
 extern unsigned g_tw_gvt_min_buckets; ///< bucketed gvt: buckets a PE passes before a round
+extern unsigned g_tw_pe_stats;        ///< PE 0 writes one line per PE to pe_stats.csv at the end
 extern unsigned g_tw_gvt_trace;       ///< bucketed gvt: PE 0 logs every count wave; time execute()
 extern unsigned g_tw_gvt_wave_events; ///< bucketed gvt: events a PE runs between count waves (0: none)
 extern unsigned g_tw_gvt_node_waves;  ///< bucketed gvt: combine each process's count-wave contributions in shared memory
diff --git a/src/scheduler/scheduler.C b/src/scheduler/scheduler.C
index 359997b..6a04bec 100644
--- a/src/scheduler/scheduler.C
+++ b/src/scheduler/scheduler.C
@@ -30,6 +30,7 @@ Scheduler::Scheduler() {
   running = false;
   parked = false;
   ended = false;
+  final_printed = pe_stats_written = false;
 
   // Initialize rng // TODO: Definitely doesn't belong here
   tw_rand_init(31, 41);
@@ -86,10 +87,44 @@ void Scheduler::all_ended() {
 
 void Scheduler::finalize_complete() {
   agg_collect_stats(cumulative_stats);
+  if (g_tw_pe_stats) {
+    const Statistics* s = cumulative_stats;
+    double rec[12] = {(double)CkMyPe(), (double)CkMyNode(), (double)CkMyRank(),
+        (double)s->events_executed, (double)s->events_committed,
+        (double)s->events_rolled_back, (double)s->remote_sends,
+        (double)s->iter_full, (double)s->iter_window, (double)s->iter_empty,
+        s->exec_time, s->total_time};
+    contribute(sizeof(rec), rec, CkReduction::concat,
+        CkCallback(CkIndex_Scheduler::pe_stats(NULL), thisProxy[0]));
+  }
   contribute(sizeof(Statistics), cumulative_stats, statsReductionType,
       CkCallback(CkIndex_Scheduler::finalize(NULL), thisProxy[0]));
 }
 
+void Scheduler::pe_stats(CkReductionMsg* msg) {
+  std::vector<std::vector<double>> recs;
+  const double* d = (const double*)msg->getData();
+  for (int i = 0; i + 12 <= (int)(msg->getSize() / sizeof(double)); i += 12) {
+    recs.emplace_back(d + i, d + i + 12);
+  }
+  delete msg;
+  std::sort(recs.begin(), recs.end());
+  FILE* f = fopen("pe_stats.csv", "w");
+  fprintf(f, "pe,process,rank,executed,committed,rolled_back,remote_sends,"
+             "batches_full,batches_window,batches_empty,exec_s,total_s\n");
+  for (const auto& r : recs) {
+    fprintf(f, "%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.6f,%.6f\n",
+        r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
+  }
+  fclose(f);
+  pe_stats_written = true;
+  exit_when_done();
+}
+
+void Scheduler::exit_when_done() {
+  if (final_printed && (pe_stats_written || !g_tw_pe_stats)) CkExit();
+}
+
 void Scheduler::finalize(CkReductionMsg* msg) {
   Statistics* final_stats = (Statistics*)msg->getData();
   final_stats->print();
@@ -99,7 +134,8 @@ void Scheduler::finalize(CkReductionMsg* msg) {
     CkAbort("Failed Simulation Expectations!\n");
   } else {
     CkPrintf("Simulation Executed Successfully!\n");
-    CkExit();
+    final_printed = true;
+    exit_when_done();
   }
 }
 
diff --git a/src/scheduler/scheduler.ci b/src/scheduler/scheduler.ci
index e8848fe..bcfcf93 100644
--- a/src/scheduler/scheduler.ci
+++ b/src/scheduler/scheduler.ci
@@ -7,6 +7,7 @@ module scheduler {
     entry [notrace, reductiontarget] void all_ended();
     entry [notrace, reductiontarget] void finalize_complete();
     entry [notrace] void finalize(CkReductionMsg* msg);
+    entry [notrace] void pe_stats(CkReductionMsg* msg);
     entry [notrace] void groups_created();
   };
 
diff --git a/src/scheduler/scheduler.h b/src/scheduler/scheduler.h
index 22678b8..b421943 100644
--- a/src/scheduler/scheduler.h
+++ b/src/scheduler/scheduler.h
@@ -67,6 +67,10 @@ class Scheduler : public CBase_Scheduler {
     void all_ended();         /**< Every PE has applied the final GVT */
     void finalize_complete();
     void finalize(CkReductionMsg *m); /**< Receives stats reduction and exits */
+    /** --pe-stats, PE 0: writes pe_stats.csv; exits once finalize() has too */
+    void pe_stats(CkReductionMsg *m);
+    bool final_printed, pe_stats_written;
+    void exit_when_done();
 
     /** Method for printing out basic info about the current progress */
     void print_progress(Time ts);
diff --git a/src/util/command_line.C b/src/util/command_line.C
index 2f184ca..b6c7400 100644
--- a/src/util/command_line.C
+++ b/src/util/command_line.C
@@ -27,6 +27,7 @@ void parse_command_line(int argc, char** argv) {
   kernel.register_argument("gvt-wave-events",      "Bucketed GVT: a PE contributes to the next count wave after executing this many events, or when it cannot execute (0 = at once; default 128)", g_tw_gvt_wave_events);
   kernel.register_argument("gvt-node-waves",       "Optimistic, bucketed GVT, not --sched-park: each process combines its PEs' count-wave contributions in shared memory and contributes once; the result comes back once per process - NO=0, YES=1 (default)", g_tw_gvt_node_waves);
   kernel.register_argument("gvt-wave-allreduce",   "With --gvt-node-waves: processes combine each count wave by recursive doubling (log2 P rounds of pairwise exchange) instead of a reduction and broadcast; needs a power-of-two process count - NO=0, YES=1", g_tw_gvt_wave_allreduce);
+  kernel.register_argument("pe-stats",             "PE 0 writes each PE's events, rollbacks and batch outcomes to pe_stats.csv at the end - NO=0, YES=1", g_tw_pe_stats);
   kernel.register_argument("gvt-trace",            "Bucketed GVT: PE 0 writes every count wave to gvt_trace.csv, and execute() is timed - NO=0, YES=1", g_tw_gvt_trace);
   kernel.register_argument("gvt-adaptive-buckets", "Bucketed GVT: hold remote events far ahead of GVT in the sender - NO=0, YES=1", g_tw_adaptive_buckets);
   kernel.register_argument("gvt-reserve-buckets",  "Bucketed GVT: hold events more than this many buckets ahead of GVT (0 = no offset cutoff)", g_tw_reserve_buckets);
-- 
