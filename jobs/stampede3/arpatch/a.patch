diff --git a/RESULTS.md b/RESULTS.md
index 6290983..d031211 100644
--- a/RESULTS.md
+++ b/RESULTS.md
@@ -2432,6 +2432,8 @@ On the Mac (one process, 8 PEs): the GVT's tuple 7.9 µs per wave, one int 5.1,
 - N3. Right: identical committed counts.
 - N4. Right: the best W at 16 nodes is back to 250 (σ 2,000) or 250–400 (σ 100).
 
+**Default since 2026-10-24** (user decision): `--gvt-node-waves=1`. The message path stays reachable with `=0` and is covered by the `*_msgwaves` test configs. Mac gate for the switch: every bucketed config 612/612 (quick shapes), engine tier 940/942 with the 2 non-passes caused by a second `lcrun` I started during the run, both 20/20 when rerun alone.
+
 **What this means:** `--gvt-node-waves` is the largest single gain since psm2, and it is free of any runtime change. The cross-engine numbers in "Current numbers" (message path) understate Charades by about 1.3× at 4 nodes; the paper-grade comparison should be rerun with it on. What is left at 16 nodes is the reduction across processes (32 members, about 180–230 µs per advance), next to try: a flatter or wider tree across processes, or contributing as soon as a process is complete rather than through an entry method.
 
 ## Baseline verification on the Mac
diff --git a/src/globals.C b/src/globals.C
index e1e4eb7..601b601 100644
--- a/src/globals.C
+++ b/src/globals.C
@@ -124,7 +124,7 @@ void clear_globals() {
   // Paced count waves are 1.0-1.38x faster on 4 nodes and remove the
   // run-to-run flip between two GVT paces (RESULTS.md, "Two speeds")
   g_tw_gvt_wave_events    = 128;
-  g_tw_gvt_node_waves     = 0;
+  g_tw_gvt_node_waves     = 1;
   g_tw_sched_park         = 0;
   g_tw_optimism_window    = 0;
   g_tw_comm_stats         = 0;
diff --git a/src/util/command_line.C b/src/util/command_line.C
index cd9bbf2..4cf7595 100644
--- a/src/util/command_line.C
+++ b/src/util/command_line.C
@@ -25,7 +25,7 @@ void parse_command_line(int argc, char** argv) {
   kernel.register_argument("gvt-bucket-size",      "Bucket size for bucketed GVT algorithm", g_tw_gvt_bucket_size);
   kernel.register_argument("gvt-min-buckets",      "Bucketed GVT: buckets a PE must pass before it starts a GVT round", g_tw_gvt_min_buckets);
   kernel.register_argument("gvt-wave-events",      "Bucketed GVT: a PE contributes to the next count wave after executing this many events, or when it cannot execute (0 = at once; default 128)", g_tw_gvt_wave_events);
-  kernel.register_argument("gvt-node-waves",       "Optimistic, bucketed GVT, not --sched-park: each process combines its PEs' count-wave contributions in shared memory and contributes once; the result comes back once per process - NO=0, YES=1", g_tw_gvt_node_waves);
+  kernel.register_argument("gvt-node-waves",       "Optimistic, bucketed GVT, not --sched-park: each process combines its PEs' count-wave contributions in shared memory and contributes once; the result comes back once per process - NO=0, YES=1 (default)", g_tw_gvt_node_waves);
   kernel.register_argument("gvt-trace",            "Bucketed GVT: PE 0 writes every count wave to gvt_trace.csv, and execute() is timed - NO=0, YES=1", g_tw_gvt_trace);
   kernel.register_argument("gvt-adaptive-buckets", "Bucketed GVT: hold remote events far ahead of GVT in the sender - NO=0, YES=1", g_tw_adaptive_buckets);
   kernel.register_argument("gvt-reserve-buckets",  "Bucketed GVT: hold events more than this many buckets ahead of GVT (0 = no offset cutoff)", g_tw_reserve_buckets);
