+sync=3
+gvt=4
+buffer-size=655360
+gvt-ask-ahead=40
diff --git a/tests/test_configs/bucket_askahead b/tests/test_configs/bucket_askahead
new file mode 100644
index 0000000..708c187
--- /dev/null
+++ b/tests/test_configs/bucket_askahead
@@ -0,0 +1,5 @@
+# bucket with --gvt-ask-ahead=-1: every count wave reports counts up to the window
+sync=3
+gvt=4
+buffer-size=655360
+gvt-ask-ahead=-1
diff --git a/tests/test_configs/bucket_hold_askahead b/tests/test_configs/bucket_hold_askahead
new file mode 100644
index 0000000..049ff4f
--- /dev/null
+++ b/tests/test_configs/bucket_hold_askahead
@@ -0,0 +1,7 @@
