+    void wave_done(const int* sums, int num_buckets, int valid_buckets,
+        const uint64_t* ctl, const uint64_t* hist, int nhist);
+
     /** Advances the GVT by the specified number of buckets */
     void advance_gvt(int num_buckets);
 
