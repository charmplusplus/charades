mainmodule redbench {
  readonly CProxy_Main mainProxy;
  readonly int K;
  readonly int R;
  readonly int WARM;
  readonly int PEER;
  readonly int MODE;
  mainchare Main {
    entry Main(CkArgMsg*);
    entry [reductiontarget] void done();
  };
  nodegroup NBench {
    entry NBench();
    entry [exclusive] void start();
    entry [exclusive] void result(CkReductionMsg* m);
    entry [exclusive] void rd(int wave, int round, int n, CmiInt8 v[n]);
  };
  group Bench {
    entry Bench();
    entry void start();
    entry void result(CkReductionMsg* m);
    entry void ping(int i);
  };
};
