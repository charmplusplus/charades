mainmodule redbench {
  readonly CProxy_Main mainProxy;
  readonly int K;
  readonly int R;
  readonly int WARM;
  mainchare Main {
    entry Main(CkArgMsg*);
    entry [reductiontarget] void done();
  };
  group Bench {
    entry Bench();
    entry void start();
    entry void result(CkReductionMsg* m);
  };
};
