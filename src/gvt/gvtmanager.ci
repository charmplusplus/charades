module gvtmanager {
  extern module completion;
  include "typedefs.h";

  /** Base group for all GVTManagers */
  group GVTManager {
    entry [notrace] GVTManager();
  };

  /** Basic Synchronous GVT */
  group SyncGVT : GVTManager {
    entry [notrace] SyncGVT();
    entry [notrace] void gvt_contribute();
    entry [notrace,reductiontarget] void gvt_end(Time);
  };

  /** Continuous GVT using Completion Detectors */
  group CdGVT : GVTManager {
    entry [notrace] CdGVT();
    entry [notrace] void broadcast_detector_proxies(int num, CProxy_CompletionDetector proxies[num]);
    entry [notrace] void gvt_contribute();
    entry [notrace,reductiontarget] void gvt_end(Time);
  };

  /** Continuous GVT without Completion Detectors */
  group PhaseGVT : GVTManager {
    entry [notrace] PhaseGVT();
    entry [notrace, reductiontarget] void check_counts(int, int);
    entry [notrace,reductiontarget] void gvt_end(Time);
  };

  /** Bucket-based GVT */
  group BucketGVT : GVTManager {
    entry [notrace] BucketGVT();
    entry [notrace] BucketGVT(CkGroupID node_waves);
    entry [notrace, reductiontarget] void all_ready(int min);
    entry [notrace] void check_counts(CkReductionMsg* msg);
  };

  /**
   * --gvt-node-waves: one per process; combines its PEs' count-wave
   * contributions in shared memory and contributes them once, and holds the
   * result the PEs read (see bucketed.h)
   */
  nodegroup NodeWaves {
    entry [notrace] NodeWaves();
    entry [notrace, exclusive] void contribute_combined(int n, CmiInt8 v[n]);
    entry [notrace, exclusive] void wave_result(CkReductionMsg* msg);
    entry [notrace, exclusive] void exchange(int wave, int round, int n, CmiInt8 v[n]);
  };
}
