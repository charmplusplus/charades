#!/bin/bash

exe=$1
shift

pes=$1
shift

args=""

for var in "$@"
do
  if [ -f $var ]
  then
    args="$args`awk '/^--/ || /^+/ { s = s $0 " " } END { print s }' $var` "
  else
    args="$args$var "
  fi
done

if [ -x ./charmrun ]
then
  command="./charmrun +p$pes $exe $args"
else
  # Reconverse: no charmrun, the executable takes +pe itself.
  command="$exe +pe $pes $args"
fi

echo "Running command: $command"

eval $command
