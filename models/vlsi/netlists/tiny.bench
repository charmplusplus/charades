# tiny.bench: a small clocked circuit for the VLSI model's tests, written for
# Charades (not an ITC'99 circuit). A 4-bit counter with enable, mixing logic
# fed by the bus inputs, and two state bits. It uses every gate type the
# model reads, fan-in up to 5, a constant input, and the ITC'99 naming of
# bus inputs (IN*), so --copies joins copies in a ring.
INPUT(EN)
INPUT(IN1_1_)
INPUT(IN1_2_)
INPUT(IN2_1_)
INPUT(LOGIC0)
OUTPUT(O1)
OUTPUT(O2)
OUTPUT(O3)
Q0 = DFF(D0)
Q1 = DFF(D1)
Q2 = DFF(D2)
Q3 = DFF(D3)
S0 = DFF(T0)
S1 = DFF(T1)
D0 = XOR(Q0, EN)
C0 = AND(Q0, EN)
D1 = XOR(Q1, C0)
C1 = AND(Q1, C0)
D2 = XOR(Q2, C1)
C2 = AND(Q2, C1)
D3 = XOR(Q3, C2)
NQ0 = NOT(Q0)
M1 = NAND(IN1_1_, Q3, Q1)
M2 = NOR(IN1_2_, Q2, LOGIC0)
M3 = OR(IN2_1_, M1, M2, Q0)
M4 = NAND(M1, M2, M3, Q3, EN)
M5 = XNOR(M4, Q1)
B5 = BUFF(M5)
T0 = XOR(S1, M3)
T1 = AND(S0, M5, NQ0)
O1 = NOR(S0, M4)
O2 = XOR(Q3, S1)
O3 = AND(B5, NQ0)
