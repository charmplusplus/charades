# As base, but worst-case traffic with minimal routing and small channel
# buffers (16 chunks global, 64 local): the one global channel between each
# pair of groups backs up, so first-hop chunks are dropped and later-hop
# chunks wait for credits (the router waiting list)
routers-per-group=4
global-channels=2
terminals-per-router=2
traffic=2
routing=0
arrive-rate=200
global-vc-size=16
local-vc-size=64
# end-time stops the run at 3 us, while packets are still in flight (the
# processes inject for ~3.2 us and the network drains by ~4-6 us). Runs that
# drain every event before end-time intermittently commit too few events
# across processes under the bucketed GVT: a process can finalize before it
# has applied the last GVT, leaving its last events uncommitted (engine issue,
# not the model: the model statistics still match).
end-time=3000000
lookahead=100
buffer-size=65536
expected-events=145180
